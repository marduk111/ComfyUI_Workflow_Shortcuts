  "source": {
    "code": "// Stem Instrument Repair — conventional corrective processing for generated stems.\n//\n// Signal chain: input -> focus band-pass and bleed-reduction notch -> transient-aware\n// level smoothing -> restrained soft saturation -> repair blend -> dry/wet mix.\n//\n// Controls:\n//   Instrument Focus — moves a broad voicing filter toward the useful body of a stem.\n//   Repair Amount — scales the corrective path before it is mixed with the input.\n//   Separation — deepens the broad filtering and complementary notch cleanup.\n//   Dynamics Smooth — steadies uneven sustained material with gentle gain smoothing.\n//   Transient Preserve — restores onset emphasis after smoothing so attacks stay present.\n//   Saturation — adds restrained soft saturation for a more continuous tone.\n//   Mix — crossfades between the original and repaired stem.\nfunction build(g, config) {\n  const sr = config.sampleRate || 48000;\n  const left = g.input('audioInL');\n  const right = g.input('audioInR');\n  const focus = g.input('Instrument Focus');\n  const repair = g.input('Repair Amount');\n  const separation = g.input('Separation');\n  const dynamics = g.input('Dynamics Smooth');\n  const transient = g.input('Transient Preserve');\n  const saturation = g.input('Saturation');\n  const mix = g.input('Mix');\n\n  const zero = g.zero();\n  const one = g.constant(1);\n  const qBroad = g.constant(0.7);\n  const qNotch = g.constant(1.5);\n\n  // Focus spans musical stem bodies from lower instrumental weight to upper detail.\n  const focusHz = g.modLog2Hz(g.constant(900), g.scale(focus, 2.4, -1.2), 120, 5200, 'focusHz');\n  const notchHz = g.modLog2Hz(g.constant(2500), g.scale(focus, 1.8, -0.9), 500, 8000, 'notchHz');\n  const separationQ = g.add(qBroad, g.mul(separation, g.constant(1.1)), 'separationQ');\n\n  function repairChannel(input, tag) {\n    const band = g.biquad({ input, cutoff: focusHz, resonance: separationQ, mode: 'bandpass' }, tag + 'Band');\n    const notch = g.biquad({ input, cutoff: notchHz, resonance: qNotch, mode: 'notch' }, tag + 'Notch');\n    const filtered = g.lerp(separation, input, g.lerp(g.constant(0.58), band, notch, tag + 'toneBlend'), tag + 'focusBlend');\n\n    const level = g.abs(filtered, tag + 'Abs');\n    const smoothTime = g.madd(g.constant(6), dynamics, 90, tag + 'smoothMs');\n    const smoothCoef = g.div(one, g.scale(smoothTime, sr / 1000), tag + 'smoothCoef');\n    const env = g.asymmetricOnePole({ target: level, attackCoef: smoothCoef, releaseCoef: g.scale(smoothCoef, 0.22) }, tag + 'Env');\n    const safeEnv = g.max(env, g.constant(0.03), tag + 'safeEnv');\n    const targetGain = g.clamp(g.div(g.constant(0.22), safeEnv, tag + 'targetGain'), 0.45, 1.7, tag + 'targetGainClamped');\n    const gain = g.lerp(dynamics, one, targetGain, tag + 'smoothGain');\n    const smoothed = g.mul(filtered, gain, tag + 'Smoothed');\n\n    const fastCoef = g.constant(1 / Math.max(1, sr * 0.002));\n    const fast = g.asymmetricOnePole({ target: level, attackCoef: fastCoef, releaseCoef: g.constant(1 / Math.max(1, sr * 0.018)) }, tag + 'Fast');\n    const onset = g.max(zero, g.sub(fast, env, tag + 'Onset'), tag + 'OnsetPositive');\n    const attackLift = g.add(one, g.mul(g.mul(onset, transient, tag + 'onsetAmt'), g.constant(1.8)), tag + 'attackLift');\n    const preserved = g.mul(smoothed, attackLift, tag + 'Preserved');\n\n    const drive = g.add(one, g.mul(saturation, g.constant(2.2)), tag + 'drive');\n    const sat = g.div(g.tanh(g.mul(preserved, drive, tag + 'satDrive'), tag + 'sat'), drive, tag + 'satLevel');\n    const continuity = g.lerp(saturation, preserved, sat, tag + 'continuity');\n    return g.lerp(repair, input, continuity, tag + 'repairBlend');\n  }\n\n  const wetL = repairChannel(left, 'L');\n  const wetR = repairChannel(right, 'R');\n  g.output('audioOutL', g.lerp(mix, left, wetL, 'outL'));\n  g.output('audioOutR', g.lerp(mix, right, wetR, 'outR'));\n}",
