{
  "id": "stem-instrument-repair",
  "kind": "effect",
  "displayName": "Stem Instrument Repair",
  "description": "A conventional stem-cleanup effect that focuses broad instrument body, reduces competing bleed emphasis, smooths uneven dynamics while retaining attacks, and adds restrained continuity saturation. It does not perform source separation, neural instrument recognition, pitch correction, or spectral reconstruction.",
